[Unit]
Description=ROS Bridge Websocket Service
After=network-online.target ros1-dynamic-bridge.service
Wants=network-online.target ros1-dynamic-bridge.service

[Service]
Type=simple
User=swu
WorkingDirectory=/home/swu
ExecStart=/bin/bash -lc 'export ROS_IP=10.25.25.108; export ROS_LOCALHOST_ONLY=0; export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/robco/fastdds_udp_only.xml; unset ROS_MASTER_URI ROS_ETC_DIR ROS_PACKAGE_PATH ROS_ROOT ROSLISP_PACKAGE_DIRECTORIES ROS_VERSION ROS_DISTRO ROS_HOSTNAME; set +u; source /opt/ros/foxy/setup.bash; set -u; exec ros2 launch rosbridge_server rosbridge_websocket_launch.xml address:=0.0.0.0 max_message_size:=100000000'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
