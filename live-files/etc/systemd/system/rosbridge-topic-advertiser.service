[Unit]
Description=ROS 2 Topic Advertiser For Rosbridge Type Inference
After=network-online.target ros1-dynamic-bridge.service
Wants=network-online.target ros1-dynamic-bridge.service

[Service]
Type=simple
User=swu
WorkingDirectory=/home/swu
ExecStart=/bin/bash -lc 'export ROS_IP=10.25.25.115; export ROS_LOCALHOST_ONLY=0; export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/robco/fastdds_udp_only.xml; unset ROS_MASTER_URI ROS_ETC_DIR ROS_PACKAGE_PATH ROS_ROOT ROSLISP_PACKAGE_DIRECTORIES ROS_VERSION ROS_DISTRO ROS_HOSTNAME; set +u; source /opt/ros/foxy/setup.bash; set -u; exec python3 /home/swu/bridge_support/ros2_topic_advertiser.py'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
